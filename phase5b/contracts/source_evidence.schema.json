{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "evidence_id", "case_id", "claim", "source_refs", "parent_verified", "status"],
  "properties": {
    "schema": {"const": "fpo.phase5b.evidence.v1"},
    "evidence_id": {"type": "string"},
    "case_id": {"type": "string"},
    "claim": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "parent_verified": {"type": "boolean"},
    "status": {"const": "accepted"}
  }
}
