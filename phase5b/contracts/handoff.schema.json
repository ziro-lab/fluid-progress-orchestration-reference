    "source_ref": {"type": "string"},
    "valid_commit_ref": {"type": "string"},
    "state_projection": {"type": "object"},
    "allowed_refs": {"type": "array", "items": {"type": "string"}},
    "prohibitions": {"type": "array", "items": {"type": "string"}}
  }
}
