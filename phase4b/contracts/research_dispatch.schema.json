{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpo.phase4b.research-dispatch.v1",
  "title": "FPO Phase 4B Research Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "capability_run_id", "dispatch_id", "operation_id", "capability_id", "capability_revision", "fixture_ref", "return_schema_ref", "research_budget", "source_policy", "authority_boundary"],
  "properties": {
    "schema": {"const": "fpo.phase4b.research-dispatch.v1"},
    "case_id": {"type": "string", "pattern": "^B[1-6]$"},
    "capability_run_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "pattern": "^DISP-B[1-6]-[0-9]{3}$"},
    "operation_id": {"type": "string", "pattern": "^OP-B[1-6]-[0-9]{3}$"},
    "capability_id": {"const": "ai.public-research.capability"},
    "capability_revision": {"const": "phase4b-v1"},
    "fixture_ref": {"type": "string", "minLength": 1},
    "return_schema_ref": {"type": "string", "minLength": 1},
    "research_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_research_rounds", "max_distinct_queries", "max_accepted_sources"],
      "properties": {
        "max_research_rounds": {"type": "integer"},
        "max_distinct_queries": {"type": "integer"},
        "max_accepted_sources": {"type": "integer"}
      }
    },
    "source_policy": {"type": "string", "minLength": 1},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_only", "may_change_fpo_authority"],
      "properties": {"return_only": {"const": true}, "may_change_fpo_authority": {"const": false}}
    }
  }
}
