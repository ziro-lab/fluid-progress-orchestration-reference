{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpo.phase7a.flow-mini-return.v1",
  "type": "object",
  "required": [
    "schema",
    "fixture",
    "stage",
    "dispatch_id",
    "input_sha256",
    "status",
    "current_revision",
    "provider",
    "fresh_context",
    "requirements",
    "observations",
    "planning",
    "operations",
    "local_validation",
    "evidence",
    "blockers",
    "reentry",
    "next_action",
    "notes"
  ],
  "properties": {
    "schema": {"const": "fpo.phase7a.flow-mini-return.v1"},
    "fixture": {"type": "string", "enum": ["I1", "I2", "I3"]},
    "stage": {"type": "string", "enum": ["planning", "execution"]},
    "dispatch_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string"},
    "current_revision": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "required": ["model", "reasoning"],
      "properties": {
        "model": {"type": "string"},
        "reasoning": {"type": "string"}
      },
      "additionalProperties": true
    },
    "fresh_context": {"const": true},
    "requirements": {"type": "array"},
    "observations": {"type": "array"},
    "planning": {"type": "object"},
    "operations": {"type": "array"},
    "local_validation": {"type": "object"},
    "evidence": {"type": "array"},
    "blockers": {"type": "array"},
    "reentry": {"type": "object"},
    "next_action": {"type": "string"},
    "notes": {"type": "array"}
  },
  "additionalProperties": false
}
