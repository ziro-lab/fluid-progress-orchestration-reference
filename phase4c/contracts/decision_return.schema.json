{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpo.phase4c.decision-return.v1",
  "title": "FPO Phase 4C Human-Last Decision Return",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "run_number", "capability_run_id", "dispatch_id", "operation_id", "capability_revision", "decision", "autonomous_routes_available", "autonomous_routes_attempted", "evidence_refs", "facts", "findings", "uncertainties", "notes", "research_trace"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^C[1-7]$"},
    "run_number": {"type": "integer"},
    "capability_run_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "pattern": "^DISP-C[1-7]-[0-9]{3}$"},
    "operation_id": {"type": "string", "pattern": "^OP-C[1-7]-[0-9]{3}$"},
    "capability_revision": {"const": "phase4c-v1"},
    "decision": {"type": "string", "enum": ["NO_HUMAN", "ESCALATE"]},
    "autonomous_routes_available": {"type": "array", "items": {"type": "string"}},
    "autonomous_routes_attempted": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "facts": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "research_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "rounds", "sources_inspected"],
      "properties": {"queries": {"type": "array", "items": {"type": "string"}}, "rounds": {"type": "integer"}, "sources_inspected": {"type": "array", "items": {"type": "string"}}}
    },
    "source_claims": {"type": "array", "items": {"$ref": "#/$defs/sourceClaim"}},
    "escalation": {"$ref": "#/$defs/escalation"}
  },
  "$defs": {
    "sourceClaim": {"type": "object", "additionalProperties": false, "required": ["source_id", "url", "title", "publisher", "source_class", "revision", "supports", "observation"], "properties": {"source_id": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https://"}, "title": {"type": "string", "minLength": 1}, "publisher": {"type": "string", "minLength": 1}, "source_class": {"type": "string", "enum": ["official_documentation", "official_repository", "primary_technical_source", "secondary_source"]}, "revision": {"type": "string", "minLength": 1}, "supports": {"type": "array", "items": {"type": "string"}}, "observation": {"type": "string", "minLength": 1}}},
    "escalation": {"type": "object", "additionalProperties": false, "required": ["escalation_id", "work_id", "work_revision", "reason_code", "blocking_question", "autonomous_actions_attempted", "evidence_refs", "why_machine_cannot_resolve", "request", "consequence_if_unanswered", "resume_plan", "authority_boundary"], "properties": {"escalation_id": {"type": "string", "pattern": "^ESC-C[3-6]-[0-9]{3}$"}, "work_id": {"type": "string", "minLength": 1}, "work_revision": {"type": "string", "minLength": 1}, "reason_code": {"type": "string", "enum": ["HUMAN_PREFERENCE", "HUMAN_AUTHORITY", "HUMAN_EVIDENCE", "HUMAN_CAPABILITY"]}, "blocking_question": {"type": "string", "minLength": 1}, "autonomous_actions_attempted": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "why_machine_cannot_resolve": {"type": "string", "minLength": 1}, "request": {"$ref": "#/$defs/request"}, "consequence_if_unanswered": {"type": "string", "minLength": 1}, "resume_plan": {"type": "string", "minLength": 1}, "authority_boundary": {"type": "object", "additionalProperties": false, "required": ["proposal_only"], "properties": {"proposal_only": {"const": true}}}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["type", "prompt", "options"], "properties": {"type": {"type": "string", "enum": ["choice", "approval", "observation", "capability"]}, "prompt": {"type": "string", "minLength": 1}, "options": {"type": "array", "items": {"type": "string"}}}}
  }
}
