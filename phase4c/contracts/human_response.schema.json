{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpo.phase4c.human-response.v1",
  "title": "FPO Phase 4C Simulated Human Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_id", "escalation_id", "work_id", "work_revision", "response_type", "answer", "source", "immutable_source"],
  "properties": {
    "response_id": {"type": "string", "pattern": "^RESP-C[3-6]-[0-9]{3}$"},
    "escalation_id": {"type": "string", "pattern": "^ESC-C[3-6]-[0-9]{3}$"},
    "work_id": {"type": "string", "minLength": 1},
    "work_revision": {"type": "string", "minLength": 1},
    "response_type": {"type": "string", "enum": ["choice", "approval", "observation", "capability"]},
    "answer": {"type": "string", "minLength": 1},
    "source": {"const": "simulated_human"},
    "immutable_source": {"const": true}
  }
}
